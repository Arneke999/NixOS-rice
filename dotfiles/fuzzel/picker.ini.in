# fuzzel config for the wallpaper picker (Super+W). Same look as the Alt+Space
# launcher (fuzzel.ini) but with icons ON, so each row shows a small thumbnail of
# the wallpaper. Matugen-templated — edit picker.ini.in, not the generated file.
[main]
font=JetBrainsMono Nerd Font:size=12
icons-enabled=yes
lines=8
width=36
horizontal-pad=18
vertical-pad=14
inner-pad=12

[colors]
background=0f0f11f2
text={{colors.on_surface.default.hex_stripped}}ff
prompt={{colors.tertiary.default.hex_stripped}}ff
placeholder=8a8a90ff
input=c8c8ceff
match={{colors.primary.default.hex_stripped}}ff
selection={{colors.primary.default.hex_stripped}}26
selection-text=e8e8eeff
selection-match={{colors.primary.default.hex_stripped}}ff
counter=8a8a90ff
border={{colors.secondary.default.hex_stripped}}ff

[border]
width=1
radius=12
