;; ── data ─────────────────────────────────────────────────────────
(defpoll time     :interval "10s" `date +%H:%M`)
(defpoll date_str :interval "1h"  `date "+%a %d %b"`)
(defpoll volume     :interval "1s"  :initial '{"muted":false,"value":0}'                             "~/nix-config/dotfiles/eww/scripts/volume.sh")
(defpoll net        :interval "5s"  :initial '{"icon":"","detail":""}'                               "~/nix-config/dotfiles/eww/scripts/net.sh")
(defpoll battery    :interval "10s" :initial '{"present":false,"capacity":0,"status":"none","charging":false,"plugged":false,"icon":"󰂑","time":""}' "~/nix-config/dotfiles/eww/scripts/battery.sh")
(defpoll brightness :interval "3s"  :initial '{"present":false,"value":0}'                           "~/nix-config/dotfiles/eww/scripts/brightness.sh")
(defpoll bluetooth  :interval "5s"  :initial '{"present":false,"powered":false,"connected":false}'   "~/nix-config/dotfiles/eww/scripts/bluetooth.sh")
(defpoll wifi       :interval "10s" :initial '{"enabled":false,"ssid":"","signal":0}'                "~/nix-config/dotfiles/eww/scripts/wifi.sh")
;; Number of tray icons (StatusNotifierItems) — used only to hide the tray pill when
;; the tray is empty, so no empty near-black blob shows left of CPU/RAM.
(defpoll tray_count :interval "2s"  :initial "0"                                                     "~/nix-config/dotfiles/eww/scripts/tray-count.sh")
;; Weather (wttr.in, IP-located) — current + 3-day forecast in one object; the popup
;; reads the same var so there's a single fetch every 15 min.
(defpoll weather    :interval "15m" :initial '{"ok":false,"icon":"󰖐","temp":0,"desc":"…","city":"","class":"cloudy","feels":0,"humidity":0,"wind":0,"forecast":[]}' "~/nix-config/dotfiles/eww/scripts/weather.sh")
;; Bluetooth device list is refreshed on demand (popup open / toggle / connect),
;; not polled, to avoid constant bluetoothctl spawns.
(defvar  bt_devices "[]")
(defvar  bt_scan "[]")           ;; newly-discovered (unpaired) devices after a scan
(defvar  bt_scanning false)      ;; true while a scan is running (button shows "scanning…")
(defvar  wifi_nets "[]")         ;; nearby Wi-Fi networks for the picker (refreshed on popup open)
(defvar  wifi_scanning false)    ;; true while a rescan runs (button shows a spinner)
(defvar  audio_sinks "[]")       ;; audio output devices for the volume popup (refreshed on open)
(defvar  osd_kind "vol")         ;; which value the on-screen display shows: "vol" | "bri"
(deflisten workspaces :initial "[]" "~/nix-config/dotfiles/eww/scripts/workspaces.sh")
;; id of a workspace that just got a window while unfocused → flash its dot ("" = none)
(deflisten ws_blink :initial "" "~/nix-config/dotfiles/eww/scripts/ws-blink.sh")
;; Now-playing (MPRIS): a deflisten pushes metadata/status on every change; position
;; is polled separately (1s) only for the seek bar so metadata isn't re-read each tick.
(deflisten mpris :initial '{"present":false,"status":"","title":"","artist":"","album":"","art":"","len":0,"lenstr":"0:00"}' "~/nix-config/dotfiles/eww/scripts/mpris.sh")
(defpoll   mpris_pos :interval "1s" :initial '{"sec":0,"str":"0:00"}' "~/nix-config/dotfiles/eww/scripts/mpris-pos.sh")
;; Quick toggles (bar buttons): caffeine (keep-awake), do-not-disturb, night light.
(defpoll caffeine   :interval "3s" :initial "false" "~/nix-config/dotfiles/eww/scripts/caffeine.sh")
(defpoll dnd        :interval "3s" :initial "false" "~/nix-config/dotfiles/eww/scripts/dnd.sh")
(defpoll nightlight :interval "3s" :initial "false" "~/nix-config/dotfiles/eww/scripts/nightlight.sh")

;; ── widgets ──────────────────────────────────────────────────────
(defwidget workspaces []
  ;; The class ternary references ws_blink eagerly (both branches are "pill ws") only
  ;; to force eww to *demand* the ws_blink deflisten — a var used solely inside a
  ;; `for` body isn't demanded, so its listener would never spawn otherwise.
  (box :class {ws_blink == "" ? "pill ws" : "pill ws"} :space-evenly false :spacing 3
    (for ws in workspaces
      (label :class {ws.is_focused ? "ws-dot focused" :
                     ws.idx == ws_blink ? "ws-dot active blink" :
                     ws.is_active ? "ws-dot active" : "ws-dot empty"}
             :text {ws.is_active ? "●" : "○"}))))

(defwidget clock []
  (eventbox :class "clock-box" :onclick "swaync-client -t -sw" :tooltip "Notifications"
    (box :class "pill clock"
      (label :text time))))

;; Now-playing module (left of the bar). Only shown when a player exists; the note
;; glyph pulses while playing. Click opens the media popup.
(defwidget music []
  ;; Only shown when something is actually loaded (title non-empty) — otherwise a
  ;; stopped/idle player left a lone note with an empty gap (the "off-centre" look).
  (eventbox :class "music-box" :visible {mpris.present && mpris.title != ""}
            :onclick "~/nix-config/dotfiles/eww/scripts/pop.sh pop-music"
            :tooltip {mpris.album}
    (box :class "pill music" :space-evenly false :spacing 8 :valign "center"
      (label :class {mpris.status == "Playing" ? "music-ic playing" : "music-ic"} :valign "center" :text "󰝚")
      (label :class "music-title" :halign "start" :valign "center" :limit-width 24
             :text {mpris.artist != "" ? "${mpris.artist} — ${mpris.title}" : mpris.title}))))

(defwidget ring [value cls icon name]
  (eventbox :tooltip "${name}  ${round(value, 0)}%"
    (circular-progress :class "ring ${cls}" :value value :thickness 4 :start-at 75 :clockwise true
      (label :class "ring-icon" :text icon))))

(defwidget metrics []
  (box :class "pill metrics" :space-evenly false :spacing 8
    ;; System tray at the LEFT end of the metrics pill (left of CPU/RAM) so the icons
    ;; live INSIDE the same pill as everything else — part of the bar, not a floating
    ;; box. Hidden when empty (tray_count) so it adds no left-gap when nothing's trayed.
    (systray :class "tray" :orientation "h" :space-evenly false :icon-size 16 :spacing 6
             :prepend-new false :visible {tray_count > 0})
    (ring :value {EWW_CPU.avg}            :cls "cpu" :icon "" :name "CPU")
    (ring :value {EWW_RAM.used_mem_perc}  :cls "ram" :icon "" :name "RAM")

    ;; Brightness — click opens the slider popup, scroll nudges it (instant update).
    (eventbox :class "bri-box" :visible {brightness.present}
              :onclick "~/nix-config/dotfiles/eww/scripts/pop.sh pop-brightness"
              :onscroll "~/nix-config/dotfiles/eww/scripts/bri-ctl.sh {}"
      (label :class "bri" :text "󰃟 ${brightness.value}%"))

    ;; Volume — click opens the popup, middle-click mutes, scroll changes it.
    (eventbox :class "vol-box"
              :onclick "~/nix-config/dotfiles/eww/scripts/audio-open.sh"
              :onmiddleclick "~/nix-config/dotfiles/eww/scripts/vol-ctl.sh mute"
              :onscroll "~/nix-config/dotfiles/eww/scripts/vol-ctl.sh {}"
      (label :class "vol"
        :text {volume.muted ? "󰝟" :
               volume.value < 34 ? "󰕿 ${volume.value}%" :
               volume.value < 67 ? "󰖀 ${volume.value}%" :
                                   "󰕾 ${volume.value}%"}))

    ;; Wi-Fi — click opens the popup (refreshes the network list first).
    (eventbox :class "net-box" :onclick "~/nix-config/dotfiles/eww/scripts/wifi-open.sh"
      (label :class "net" :text {net.icon} :tooltip {net.detail}))

    ;; Bluetooth — click opens the popup (refreshes device list first),
    ;; middle-click toggles the adapter.
    (eventbox :class "bt-box" :visible {bluetooth.present}
              :onclick "~/nix-config/dotfiles/eww/scripts/bt-open.sh"
              :onmiddleclick "~/nix-config/dotfiles/eww/scripts/bt-toggle.sh"
      (label :class {bluetooth.connected ? "bt connected" : bluetooth.powered ? "bt on" : "bt off"}
             :text {bluetooth.connected ? "󰂱" : bluetooth.powered ? "󰂯" : "󰂲"}))

    ;; Battery — clear icon + %, glyph reflects level, colour reflects charge state.
    (box :class "bat-box" :visible {battery.present}
         :tooltip "battery  ${battery.capacity}%  ·  ${battery.status}${battery.time != "" ? "  ·  " + battery.time : ""}"
      (label :class {battery.charging ? "bat charging" :
                     battery.plugged  ? "bat plugged" :
                     battery.capacity <= 15 ? "bat low" : "bat"}
             :text "${battery.icon} ${battery.capacity}%"))

    ;; Quick toggles — caffeine (keep-awake), do-not-disturb, night light. Icon-only;
    ;; lit pink when active, muted when off.
    (button :class {caffeine ? "qs on" : "qs"} :tooltip {caffeine ? "Caffeine: on (screen stays awake)" : "Caffeine: off"}
            :onclick "~/nix-config/dotfiles/eww/scripts/caffeine.sh toggle"
      (label :text {caffeine ? "󰅶" : "󰛊"}))
    (button :class {dnd ? "qs on" : "qs"} :tooltip {dnd ? "Do Not Disturb: on" : "Do Not Disturb: off"}
            :onclick "~/nix-config/dotfiles/eww/scripts/dnd.sh toggle"
      (label :text {dnd ? "󰂛" : "󰂚"}))
    (button :class {nightlight ? "qs on" : "qs"} :tooltip {nightlight ? "Night light: on (4000K)" : "Night light: off"}
            :onclick "~/nix-config/dotfiles/eww/scripts/nightlight.sh toggle"
      (label :text {nightlight ? "󰽥" : "󰃞"}))

    ;; Weather — animated condition glyph + temp; click opens the forecast popup.
    ;; Hidden until the first successful fetch so no placeholder flashes at login.
    (eventbox :class "wthr-box" :visible {weather.ok}
              :onclick "~/nix-config/dotfiles/eww/scripts/pop.sh pop-weather"
      (label :class "weather ${weather.class}" :text "${weather.icon} ${weather.temp}°"
             :tooltip "${weather.city} · ${weather.desc}"))

    (eventbox :class "date-box" :onclick "~/nix-config/dotfiles/eww/scripts/pop.sh calendar"
      (label :class "date" :text date_str))))

;; ── popups ───────────────────────────────────────────────────────
(defwidget pop-brightness-w []
  (box :class "pill popup" :orientation "v" :space-evenly false :spacing 8
    (label :class "popup-title" :halign "start" :text "Brightness")
    (box :space-evenly false :spacing 10
      (label :class "popup-icon" :text "󰃟")
      (scale :class "popup-scale" :hexpand true :orientation "h" :flipped false
             :value {brightness.value} :min 1 :max 101
             :onchange "~/nix-config/dotfiles/eww/scripts/bri-ctl.sh set {}")
      (label :class "popup-val" :text "${brightness.value}%"))))

(defwidget pop-audio-w []
  (box :class "pill popup" :orientation "v" :space-evenly false :spacing 8
    (label :class "popup-title" :halign "start" :text "Volume")
    (box :space-evenly false :spacing 10
      (eventbox :class "popup-icon-btn" :onclick "~/nix-config/dotfiles/eww/scripts/vol-ctl.sh mute"
        (label :class "popup-icon" :text {volume.muted ? "󰝟" : "󰕾"}))
      (scale :class "popup-scale" :hexpand true :orientation "h" :flipped false
             :value {volume.muted ? 0 : volume.value} :min 0 :max 101
             :onchange "~/nix-config/dotfiles/eww/scripts/vol-ctl.sh set {}")
      (label :class "popup-val" :text {volume.muted ? "muted" : "${volume.value}%"}))
    ;; Output device picker — only shown when there's more than one sink. Click a row
    ;; to make it the default output. Reuses the .bt-dev row styling (active = pink).
    (box :orientation "v" :space-evenly false :spacing 3 :visible {arraylength(audio_sinks) > 1}
      (label :class "popup-sub" :halign "start" :text "Output")
      (for s in audio_sinks
        (button :class {s.active ? "bt-dev connected" : "bt-dev"}
                :onclick "~/nix-config/dotfiles/eww/scripts/audio-set.sh ${s.id}"
          (box :space-evenly false :spacing 8
            (label :text {s.active ? "󰄬" : "󰕾"})
            (label :hexpand true :halign "start" :limit-width 28 :text {s.name})))))))

(defwidget pop-wifi-w []
  (box :class "pill popup" :orientation "v" :space-evenly false :spacing 10
    (box :space-evenly false :spacing 8
      (label :class "popup-title" :hexpand true :halign "start" :text "Wi-Fi")
      ;; Always clickable — the spinner is a visual cue only. Gating onclick on
      ;; wifi_scanning meant a scan that never reset the flag left the button dead.
      (button :class "popup-manage" :tooltip "Rescan"
              :onclick "~/nix-config/dotfiles/eww/scripts/wifi-rescan.sh"
        (label :text {wifi_scanning ? "󱥸" : "󰑐"}))
      (button :class {wifi.enabled ? "toggle on" : "toggle off"}
              :onclick "~/nix-config/dotfiles/eww/scripts/wifi-toggle.sh"
        (label :text {wifi.enabled ? "on" : "off"})))
    (label :class "popup-sub" :halign "start" :wrap true
           :text {!wifi.enabled ? "radio off" :
                  wifi.ssid != "" ? "${wifi.ssid}  ·  ${wifi.signal}%" : "not connected"})
    ;; Scrollable list of nearby networks — click to (re)connect; secured ones prompt
    ;; for a password in a themed fuzzel. Reuses the .bt-dev row styling.
    (scroll :height 220 :vscroll true :visible {wifi.enabled && arraylength(wifi_nets) > 0}
      (box :orientation "v" :space-evenly false :spacing 3
        (for n in wifi_nets
          (button :class {n.active ? "bt-dev connected" : "bt-dev"}
                  :onclick "~/nix-config/dotfiles/eww/scripts/wifi-connect.sh '${n.ssid}' ${n.secure}"
            (box :space-evenly false :spacing 8
              (label :text {n.signal >= 80 ? "󰤨" : n.signal >= 55 ? "󰤥" :
                            n.signal >= 30 ? "󰤢" : n.signal >= 5 ? "󰤟" : "󰤯"})
              (label :hexpand true :halign "start" :limit-width 18 :text {n.ssid})
              (label :class "wifi-lock" :text {n.secure ? "󰌾" : ""}))))))
    (label :class "popup-sub" :halign "start"
           :visible {wifi.enabled && arraylength(wifi_nets) == 0}
           :text "no networks — hit rescan")))

(defwidget pop-bt-w []
  (box :class "pill popup" :orientation "v" :space-evenly false :spacing 10
    (box :space-evenly false :spacing 8
      (label :class "popup-title" :hexpand true :halign "start" :text "Bluetooth")
      (button :class {bluetooth.powered ? "toggle on" : "toggle off"}
              :onclick "~/nix-config/dotfiles/eww/scripts/bt-toggle.sh"
        (label :text {bluetooth.powered ? "on" : "off"})))
    (box :orientation "v" :space-evenly false :spacing 4
         :visible {bluetooth.powered && (arraylength(bt_devices) > 0)}
      (for d in bt_devices
        (button :class {d.connected ? "bt-dev connected" : "bt-dev"}
                :onclick "~/nix-config/dotfiles/eww/scripts/bt-connect.sh ${d.mac}"
          (box :space-evenly false :spacing 8
            (label :text {d.connected ? "󰂱" : "󰂯"})
            (label :hexpand true :halign "start" :limit-width 18 :text {d.name})
            ;; battery % — only for devices that report one (AirPods usually don't)
            (label :class "bt-bat" :visible {d.battery >= 0} :text "󰥉 ${d.battery}%")))))
    (label :class "popup-sub" :halign "start"
           :visible {bluetooth.powered && (arraylength(bt_devices) == 0)}
           :text "no paired devices")
    ;; Newly-discovered devices from a scan — click to pair + connect.
    (box :orientation "v" :space-evenly false :spacing 4
         :visible {bluetooth.powered && arraylength(bt_scan) > 0}
      (label :class "popup-sub" :halign "start" :text "nearby")
      (for s in bt_scan
        (button :class "bt-dev" :onclick "~/nix-config/dotfiles/eww/scripts/bt-pair.sh ${s.mac}"
          (box :space-evenly false :spacing 8
            (label :text "󰂲")
            (label :hexpand true :halign "start" :limit-width 18 :text {s.name})
            (label :class "wifi-lock" :text "pair")))))
    (button :class "popup-manage" :visible {bluetooth.powered}
            :onclick "~/nix-config/dotfiles/eww/scripts/bt-scan-run.sh"
      (label :text {bt_scanning ? "scanning…" : "Scan for devices"}))))

(defwidget pop-weather-w []
  (box :class "pill popup wthr-pop" :orientation "v" :space-evenly false :spacing 12
    ;; header: city + current description
    (box :space-evenly false :spacing 8
      (label :class "popup-title" :hexpand true :halign "start" :text {weather.city})
      (label :class "popup-sub" :halign "end" :text {weather.desc}))
    ;; current: big animated glyph + temperature, with feels/humidity/wind
    (box :space-evenly false :spacing 14 :halign "start"
      (label :class "weather ${weather.class} wthr-big" :text {weather.icon})
      (box :orientation "v" :space-evenly false :spacing 2 :valign "center"
        (label :class "wthr-temp" :halign "start" :text "${weather.temp}°C")
        (label :class "popup-sub" :halign "start"
               :text "feels ${weather.feels}°   󰖎 ${weather.humidity}%   󰖝 ${weather.wind} km/h")))
    ;; 3-day forecast row
    (box :class "wthr-fc" :space-evenly true :spacing 6
      (for d in {weather.forecast}
        (box :class "wthr-day" :orientation "v" :space-evenly false :spacing 3
          (label :class "popup-sub" :text {d.day})
          (label :class "weather ${d.class} wthr-fc-ic" :text {d.icon})
          (label :class "wthr-hilo" :text "${d.hi}°")
          (label :class "wthr-lo"   :text "${d.lo}°"))))))

(defwidget pop-music-w []
  (box :class "pill popup music-pop" :orientation "v" :space-evenly false :spacing 12
    ;; album art + track/artist/album
    (box :space-evenly false :spacing 14 :valign "center"
      (box :class "music-art" :valign "center" :visible {mpris.art != ""}
        (image :path {mpris.art} :image-width 92 :image-height 92))
      (box :orientation "v" :space-evenly false :spacing 3 :valign "center" :hexpand true
        (label :class "music-t"    :halign "start" :limit-width 24 :text {mpris.title})
        (label :class "popup-sub"  :halign "start" :limit-width 24 :text {mpris.artist})
        (label :class "popup-sub"  :halign "start" :limit-width 24 :text {mpris.album})))
    ;; seek bar: elapsed / total
    (box :space-evenly false :spacing 8
      (label :class "music-time" :text {mpris_pos.str})
      (scale :class "music-seek" :hexpand true :active false
             :value {mpris.len > 0 ? (mpris_pos.sec / mpris.len * 100) : 0} :min 0 :max 100)
      (label :class "music-time" :text {mpris.lenstr}))
    ;; transport controls
    (box :halign "center" :space-evenly false :spacing 20
      (button :class "music-btn"     :onclick "~/nix-config/dotfiles/eww/scripts/mpris-ctl.sh prev"   (label :text "󰒮"))
      (button :class "music-btn big" :onclick "~/nix-config/dotfiles/eww/scripts/mpris-ctl.sh toggle" (label :text {mpris.status == "Playing" ? "󰏤" : "󰐊"}))
      (button :class "music-btn"     :onclick "~/nix-config/dotfiles/eww/scripts/mpris-ctl.sh next"   (label :text "󰒭")))))

;; On-screen display for volume/brightness (scripts/osd.sh shows it, auto-hides it).
;; Reads the same `volume` / `brightness` vars as the bar, so it can never disagree.
(defwidget osd-w []
  (box :class "pill osd" :space-evenly false :spacing 14
    (label :class "osd-icon"
           :text {osd_kind == "bri" ? "󰃟" :
                  volume.muted ? "󰝟" : volume.value < 34 ? "󰕿" : volume.value < 67 ? "󰖀" : "󰕾"})
    (progress :class "osd-bar" :hexpand true :valign "center"
              :value {osd_kind == "bri" ? brightness.value : (volume.muted ? 0 : volume.value)})
    (label :class "osd-val"
           :text {osd_kind == "bri" ? "${brightness.value}%" : volume.muted ? "muted" : "${volume.value}%"})))

;; ── bar ──────────────────────────────────────────────────────────
(defwindow bar
  :monitor 0
  :geometry (geometry :x "0" :y "0" :width "100%" :height "46px" :anchor "top center")
  :exclusive true
  :stacking "fg"
  (centerbox :class "bar"
    (box :halign "start" :space-evenly false :spacing 0
      (workspaces)
      (music))
    (box :halign "center" (clock))
    (box :halign "end"    (metrics))))

;; Fullscreen transparent click-catcher opened behind every popup. A click that
;; lands off the popup hits this and closes the lot (eww has no native
;; close-on-focus-loss). Popups open AFTER it, so they stack above it.
(defwindow pop-backdrop
  :monitor 0 :stacking "overlay" :focusable false
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  (eventbox :onclick "~/nix-config/dotfiles/eww/scripts/pop.sh close"
    (box :class "backdrop")))

(defwindow calendar
  :monitor 0 :stacking "overlay"
  :geometry (geometry :y "6px" :x "8px" :anchor "top right" :width "260px")
  (box :class "pill cal-pop"
    (calendar :class "cal")))

(defwindow pop-brightness
  :monitor 0 :stacking "overlay"
  :geometry (geometry :y "6px" :x "8px" :anchor "top right" :width "260px")
  (pop-brightness-w))

(defwindow pop-audio
  :monitor 0 :stacking "overlay"
  :geometry (geometry :y "6px" :x "8px" :anchor "top right" :width "300px")
  (pop-audio-w))

(defwindow pop-wifi
  :monitor 0 :stacking "overlay"
  :geometry (geometry :y "6px" :x "8px" :anchor "top right" :width "260px")
  (pop-wifi-w))

(defwindow pop-bt
  :monitor 0 :stacking "overlay"
  :geometry (geometry :y "6px" :x "8px" :anchor "top right" :width "260px")
  (pop-bt-w))

(defwindow pop-weather
  :monitor 0 :stacking "overlay"
  :geometry (geometry :y "6px" :x "8px" :anchor "top right" :width "300px")
  (pop-weather-w))

(defwindow osd
  :monitor 0 :stacking "overlay" :focusable false
  :geometry (geometry :anchor "bottom center" :y "90px" :width "300px")
  (osd-w))

(defwindow pop-music
  :monitor 0 :stacking "overlay"
  :geometry (geometry :y "6px" :x "8px" :anchor "top left" :width "320px")
  (pop-music-w))
