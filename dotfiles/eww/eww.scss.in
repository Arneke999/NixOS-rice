* {
  all: unset;
  font-family: "JetBrainsMono Nerd Font";
  font-size: 14px;
}

.bar {
  background-color: transparent;
  padding: 6px 8px;
}

.pill {
  background-color: #0f0f11;
  border: 1px solid #1e1e22;
  border-radius: 16px;
  padding: 0 12px;
  margin: 0 4px;
}

.ws-dot {
  font-size: 12px;
  padding: 0 2px;
  color: #55555b;
}
.ws-dot.empty   { color: #3a3a40; }
.ws-dot.focused { color: {{colors.primary.default.hex}}; }

.clock label { color: {{colors.primary.default.hex}}; }

.metrics label { padding: 0 6px; }

.ring {
  min-width: 27px;
  min-height: 27px;
  margin: 0 4px;
  background-color: #2a2a30;
}
.ring.cpu { color: {{colors.primary.default.hex}}; }
.ring.ram { color: {{colors.tertiary.default.hex}}; }
.ring.bat { color: {{colors.secondary.default.hex}}; }
.ring.bat.charging { color: #7fd6a0; }
.ring.bat.low { color: #ff5555; }
.ring-icon { font-size: 10px; color: #8a8a90; }

.vol,
.net,
.bri,
.bat,
.date { color: {{colors.secondary.default.hex}}; }

// Battery is now a plain icon + % label (was a ring): colour signals the state.
.bat.charging { color: #7fd6a0; }
.bat.plugged  { color: {{colors.secondary.default.hex}}; }
.bat.low      { color: #ff5555; }

.bt { color: #8a8a90; }
.bt.on { color: {{colors.secondary.default.hex}}; }
.bt.connected { color: {{colors.primary.default.hex}}; }

// Click-away backdrop behind popups — a real (near-invisible) surface so it
// still catches pointer events; not fully transparent, which some GTK builds
// treat as click-through.
.backdrop { background-color: rgba(0, 0, 0, 0.01); }

tooltip {
  background-color: #0f0f11;
  border: 1px solid #1e1e22;
  border-radius: 10px;
}
tooltip label {
  color: #c8c8ce;
  padding: 4px 8px;
}

.cal-pop { padding: 10px; }
.cal-pop calendar {
  color: #c8c8ce;
  padding: 4px;
}
.cal-pop calendar:selected { color: {{colors.primary.default.hex}}; }
.cal-pop calendar.header { color: {{colors.primary.default.hex}}; }

// ── popups (brightness / audio / wifi / bluetooth) ────────────────
.popup { padding: 14px 16px; }
.popup-title { color: {{colors.primary.default.hex}}; font-size: 13px; }
.popup-sub   { color: #8a8a90; font-size: 12px; }
.popup-icon  { color: {{colors.secondary.default.hex}}; font-size: 18px; }
.popup-icon-btn { padding: 0 2px; }
.popup-val   { color: #c8c8ce; font-size: 12px; min-width: 40px; }

// eww scale (slider) — pink filled track, near-black trough, round knob.
scale trough {
  background-color: #2a2a30;
  border-radius: 12px;
  min-height: 6px;
  min-width: 120px;
}
scale trough highlight {
  background-color: {{colors.primary.default.hex}};
  border-radius: 12px;
}
scale slider {
  background-color: #c8c8ce;
  border-radius: 50%;
  min-height: 14px;
  min-width: 14px;
  margin: -6px 0;
}

// on/off pill toggles + list rows + launcher button.
.toggle { padding: 2px 14px; border-radius: 10px; }
.toggle.on  { background-color: {{colors.primary.default.hex}}; color: #0f0f11; }
.toggle.off { background-color: #2a2a30; color: #8a8a90; }

.bt-dev {
  padding: 4px 8px;
  border-radius: 8px;
  color: #c8c8ce;
  background-color: transparent;
}
.bt-dev:hover { background-color: #1a1a1f; }
.bt-dev.connected { color: {{colors.primary.default.hex}}; }

.popup-manage {
  padding: 6px;
  border-radius: 10px;
  background-color: #17171a;
  color: #c8c8ce;
}
.popup-manage:hover { background-color: #22222a; }
